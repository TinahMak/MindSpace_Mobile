{
  "expo": {
    "name": "MindSpace",
    "slug": "MindSpace_Mobile",
    "scheme": "mindspace",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.mindspace.mobile"
    },
    "android": {
      "package": "app.mindspace.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F8F4EE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "MindSpace uses your photos only when you choose one to share in AI chat.",
          "cameraPermission": "MindSpace uses the camera only when you take a photo to share in AI chat."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7A9E87"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F8F4EE"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MindSpace uses your approximate location only when you search for professionals near you. It is never stored."
        }
      ]
    ],
    "backgroundColor": "#F8F4EE"
  }
}